# Logs
/logs
*.log

# Whop runtime outputs (rebuilt by each run; do not commit)
MBM/Whop/logs/
MBM/Whop/__pycache__/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.venv/
dist
dist-ssr
*.local

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vite

# Build artifacts & temp files
*.tsbuildinfo
*.bak.*
*.bak
celerybeat-schedule.*
build_err.txt
build_log.txt
gateway_launch*.log
*.pyc
__pycache__/

# Embedded sub-repositories (vendored, not tracked directly)
MBM/Scripts/keelead/
MBM/Scripts/lead-pipeline/
MBM/Scripts/leadhunter-pro/
MBM/Scripts/leadhunter/
MBM/Scripts/wholesaile/
