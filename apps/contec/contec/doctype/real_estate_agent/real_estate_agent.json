{
  "name": "Real Estate Agent",
  "doctype": "DocType",
  "module": "Contec",
  "custom": 0,
  "is_submittable": 0,
  "track_changes": 1,
  "naming_rule": "Expression (old style)",
  "autoname": "format:REA-{YYYY}-{#####}",
  "engine": "InnoDB",
  "field_order": [
    "identity_section", "agent_name", "brokerage",
    "contact_section", "phone", "email", "website",
    "market_section", "market", "market_median_price", "state", "city",
    "inventory_section", "active_listings", "listings_last_90d",
    "presentation_quality", "has_video",
    "signals_section", "social_url", "social_followers",
    "brokerage_agent_count", "repeat_client_signal", "high_turnover_market",
    "pipeline_section", "qualification_score", "qualification_tier",
    "dialer_state", "crm_stage", "current_package",
    "last_contact", "next_action", "assigned_operator", "notes"
  ],
  "fields": [
    {"fieldname": "identity_section", "fieldtype": "Section Break", "label": "Identity"},
    {"fieldname": "agent_name", "fieldtype": "Data", "label": "Agent Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "brokerage", "fieldtype": "Data", "label": "Brokerage"},
    {"fieldname": "contact_section", "fieldtype": "Section Break", "label": "Professional Contact"},
    {"fieldname": "phone", "fieldtype": "Data", "label": "Phone"},
    {"fieldname": "email", "fieldtype": "Data", "label": "Email", "options": "Email"},
    {"fieldname": "website", "fieldtype": "Data", "label": "Website", "options": "URL"},
    {"fieldname": "market_section", "fieldtype": "Section Break", "label": "Market"},
    {"fieldname": "market", "fieldtype": "Data", "label": "Market"},
    {"fieldname": "market_median_price", "fieldtype": "Currency", "label": "Market Median Price"},
    {"fieldname": "state", "fieldtype": "Data", "label": "State"},
    {"fieldname": "city", "fieldtype": "Data", "label": "City"},
    {"fieldname": "inventory_section", "fieldtype": "Section Break", "label": "Inventory"},
    {"fieldname": "active_listings", "fieldtype": "Int", "label": "Active Listings", "default": "0"},
    {"fieldname": "listings_last_90d", "fieldtype": "Int", "label": "Listings Last 90 Days", "default": "0"},
    {"fieldname": "presentation_quality", "fieldtype": "Select",
     "label": "Presentation Quality",
     "options": "\nPOOR\nMIXED\nGOOD\nPROFESSIONAL"},
    {"fieldname": "has_video", "fieldtype": "Check", "label": "Has Video On Listings", "default": "0"},
    {"fieldname": "signals_section", "fieldtype": "Section Break", "label": "Signals"},
    {"fieldname": "social_url", "fieldtype": "Data", "label": "Social URL", "options": "URL"},
    {"fieldname": "social_followers", "fieldtype": "Int", "label": "Social Followers", "default": "0"},
    {"fieldname": "brokerage_agent_count", "fieldtype": "Int", "label": "Brokerage Agent Count", "default": "0"},
    {"fieldname": "repeat_client_signal", "fieldtype": "Check", "label": "Repeat Client Signal", "default": "0"},
    {"fieldname": "high_turnover_market", "fieldtype": "Check", "label": "High Turnover Market", "default": "0"},
    {"fieldname": "pipeline_section", "fieldtype": "Section Break", "label": "Pipeline"},
    {"fieldname": "qualification_score", "fieldtype": "Int", "label": "Qualification Score", "read_only": 1, "default": "0"},
    {"fieldname": "qualification_tier", "fieldtype": "Select",
     "label": "Tier", "options": "\nA\nB\nC\nD", "read_only": 1},
    {"fieldname": "dialer_state", "fieldtype": "Select",
     "label": "Dialer State", "default": "READY", "in_list_view": 1,
     "options": "READY\nDIALED\nCONNECTED\nNO_ANSWER\nCALLBACK\nINTERESTED\nSAMPLE_REQUESTED\nSAMPLE_SENT\nQUOTED\nNEGOTIATING\nWON\nLOST\nDO_NOT_CONTACT"},
    {"fieldname": "crm_stage", "fieldtype": "Select", "label": "CRM Stage", "default": "New Lead", "read_only": 1,
     "options": "New Lead\nQualified\nSample Candidate\nSample Generated\nContacted\nConnected\nSample Sent\nInterested\nQuote Sent\nNegotiating\nWon\nFulfillment\nRepeat Customer\nLost\nDo Not Contact"},
    {"fieldname": "current_package", "fieldtype": "Data", "label": "Current Package"},
    {"fieldname": "last_contact", "fieldtype": "Datetime", "label": "Last Contact"},
    {"fieldname": "next_action", "fieldtype": "Small Text", "label": "Next Action"},
    {"fieldname": "assigned_operator", "fieldtype": "Link", "label": "Assigned Operator", "options": "User"},
    {"fieldname": "notes", "fieldtype": "Text", "label": "Notes"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Sales User", "read": 1, "write": 1, "create": 1}
  ],
  "links": []
}
