# =============================================================================
# clipping-factory / jarvis-mbm backend — SAMPLE ENVIRONMENT
# Copy to `.env` and fill in real values. NEVER commit `.env` (git-ignored).
# No real secrets are included here.
# =============================================================================

# ---- Core ----
APP_ENV=development
APP_SECRET_KEY=change-me
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---- Database (local Postgres) ----
DATABASE_URL=postgresql+asyncpg://clipuser:clippass@localhost:5432/clipping_factory

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- Storage (MinIO / S3-compatible, local fallback) ----
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_SOURCE=source-content
STORAGE_BUCKET_CLIPS=clips
STORAGE_BUCKET_DELIVERABLES=deliverables
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

# ---- AI keys (optional; Ollama is free/local) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
RUNWARE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.0-flash

# ---- Ollama local LLM (no key, no internet) ----
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# ---- Whisper (transcription) ----
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---- Video ----
FFMPEG_PATH=
VIDEO_TEMP_DIR=C:/temp/clips

# ---- Clipping.com (set real creds to leave demo mode) ----
CLIPPING_BASE_URL=https://clipping.com
CLIPPING_EMAIL=
CLIPPING_PASSWORD=
CLIPPING_DEMO_MODE=false

# ---- Social publishing (browser automation) ----
PUBLISH_PLATFORMS=youtube,tiktok,instagram
PUBLISH_HEADLESS=true
AUTO_PUBLISH=false
AUTO_SUBMIT=false

# ---- Monetization (good-news-only by default) ----
MONETIZATION_ENABLED=false
MONETIZATION_GOOD_NEWS_ONLY=true
MONETIZATION_WEBHOOK_URL=

# ---- Telegram alerts ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATION_LEVEL=important

# ---- Enhancement ----
ENHANCEMENT_ENABLED=true
ENHANCEMENT_UPSCALE=true
ENHANCEMENT_CRF=16
ENHANCEMENT_PRESET=veryslow

# =============================================================================
# jarvis-mbm integrated services (Tailscale-only / 127.0.0.1)
# =============================================================================
LANGFLOW_BASE_URL=http://localhost:7860
LANGFLOW_API_KEY=
BROWSER_USE_API_URL=http://localhost:8001
BROWSER_USE_API_KEY=
MAXUN_API_URL=http://localhost:8000
MAXUN_API_KEY=
OPEN_WEBUI_URL=http://localhost:3000
QDRANT_URL=http://localhost:6333

# =============================================================================
# YouTube OAuth — DO NOT store secrets in code.
# 1. Create OAuth client (Desktop app) in Google Cloud Console.
# 2. Download client_secret_*.json and save it as youtube_client_secret.json.
# 3. Run:  python scripts/youtube_oauth_setup.py   (opens browser, one-time).
# 4. Tokens are written to youtube_tokens.json (git-ignored).
# =============================================================================
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_CLIENT_SECRETS_PATH=youtube_client_secret.json
YOUTUBE_TOKENS_PATH=youtube_tokens.json
YOUTUBE_DEFAULT_PRIVACY=unlisted
YOUTUBE_DEFAULT_CATEGORY_ID=28

# Pipeline artifact directories
PIPELINE_DATA_DIR=data/pipeline
UPLOADS_DIR=data/uploads
TRANSCRIPTS_DIR=data/transcripts
THUMBNAILS_DIR=data/thumbnails
