# ============================================================
# CLIPPING FACTORY — ENVIRONMENT VARIABLES
# Copy to .env and fill in your values.
# ============================================================
# FREE-ONLY SETUP: this config uses zero paid AI services.
#   AI provider order: Gemini (free) → Ollama/qwen2.5:7b (local, free)
#   Transcription: faster-whisper (local, free)
#   No Anthropic key needed. No OpenAI key needed.
# ============================================================

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://clipuser:clippass@postgres:5432/clipping_factory
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Storage (MinIO — runs locally via Docker, free) ---
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_SOURCE=source-content
STORAGE_BUCKET_CLIPS=clips
STORAGE_BUCKET_DELIVERABLES=deliverables
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

# ============================================================
# AI — FREE SOURCES ONLY
# ============================================================

# --- OPTION 1: Google Gemini (FREE tier, best quality) ---
# Get a free key at: aistudio.google.com → Get API Key
# Free limits: 1,500 req/day, 1M token context (gemini-2.0-flash)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.0-flash

# --- OPTION 2: Ollama (100% local, FREE, no internet needed) ---
# Already installed: qwen2.5:7b (4.7 GB, pulled)
# Runs automatically when Docker starts — no key needed
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# --- Paid providers — leave blank to skip ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AI settings
AI_PRIMARY_MODEL=gemini-2.0-flash
AI_FAST_MODEL=gemini-2.0-flash
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.3
AI_COST_CAP_PER_CAMPAIGN=0.00
AI_CACHE_SYSTEM_PROMPT=false
AI_EXTENDED_THINKING=false

# ============================================================
# WHISPER — local transcription (FREE, no API key needed)
# ============================================================
WHISPER_MODEL=base        # tiny=fastest | base=balanced | small=better accuracy
WHISPER_DEVICE=cpu        # cpu (always works) | cuda (GPU, much faster)
WHISPER_COMPUTE_TYPE=int8

# ============================================================
# VIDEO PROCESSING (ffmpeg — free, bundled)
# ============================================================
FFMPEG_PATH=
MAX_VIDEO_DURATION_SECONDS=7200
MAX_CLIP_DURATION_SECONDS=180
MIN_CLIP_DURATION_SECONDS=15
VIDEO_TEMP_DIR=C:/temp/clips

# ============================================================
# CLIPPING.COM — your account (required)
# ============================================================
CLIPPING_BASE_URL=https://clipping.com
CLIPPING_EMAIL=your@email.com
CLIPPING_PASSWORD=your_password
CLIPPING_SCAN_INTERVAL_SECONDS=300
CLIPPING_MAX_CAMPAIGNS_PER_SCAN=20
CLIPPING_SESSION_REFRESH_HOURS=12

# ============================================================
# CLIPPING PLATFORM SESSIONS (Vyro / Reach.cat / ClipAffiliates / Clipping.com)
# ============================================================
# Export logged-in creator sessions via:
#   python scripts/export_clipping_sessions.py
# Then paste each value below (single line of JSON). Empty => that
# platform's delivery is simulated (mock submit) instead of real.
VYRO_SESSION_STATE=
REACHCAT_SESSION_STATE=
CLIPAFFILIATES_SESSION_STATE=
CLIPPINGCOM_SESSION_STATE=

# ============================================================
# PROCESSING
# ============================================================
MAX_CONCURRENT_CAMPAIGNS=3
MAX_CLIPS_PER_CAMPAIGN=10
CLIP_SCORE_THRESHOLD=0.65
AUTO_SUBMIT=false          # keep false until you've reviewed a few clips manually

# ============================================================
# ALERTS (optional)
# ============================================================
ALERT_WEBHOOK_URL=
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ============================================================
# DASHBOARD
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_SECRET=change-me-nextauth-secret
NEXTAUTH_URL=http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# ============================================================
# MONITORING
# ============================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin

# ============================================================
# MCP SERVER
# ============================================================
MCP_PORT=8001
