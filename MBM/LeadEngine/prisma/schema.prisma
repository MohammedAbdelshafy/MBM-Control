  propertyId       String?  @map("property_id") @db.Uuid
  phone            String
  disposition      String
  notes            String?  @db.Text
  agentId          String?  @map("agent_id")
  callbackAt       DateTime? @map("callback_at")
  createdAt        DateTime @default(now()) @map("created_at")

