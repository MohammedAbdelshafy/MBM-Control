  estimatedValue  Float?    @map("estimated_value")
  venue           String?
  caseNumber      String?   @map("case_number")
  source          String
  sourceUrl       String?   @map("source_url")
  status          String    @default("scheduled")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([propertyId])
  @@index([auctionDate])
  @@index([status])
  @@map("auctions")
}

model OwnerEntity {
  id               String   @id @default(uuid()) @db.Uuid
  canonicalName    String   @map("canonical_name")
  entityType       String   @map("entity_type")
  stateOfFiling    String?  @map("state_of_filing") @db.VarChar(2)
  registrationId   String?  @map("registration_id")
  officerName      String?  @map("officer_name")
  officerTitle     String?  @map("officer_title")
  confidenceScore  Float    @default(0.8) @map("confidence_score")
  verifiedAt       DateTime? @map("verified_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([canonicalName])
  @@index([officerName])
  @@map("owner_entities")
}

model PortfolioRelationship {
  id              String   @id @default(uuid()) @db.Uuid
  entityId        String   @map("entity_id") @db.Uuid
  propertyId      String   @map("property_id") @db.Uuid
  verificationDoc String?  @map("verification_doc")
  confidence      Float    @default(0.9)
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([entityId, propertyId])
  @@index([entityId])
  @@index([propertyId])
  @@map("portfolio_relationships")
}

model LeadDisposition {
  id               String   @id @default(uuid()) @db.Uuid
