# MBM Lead Engine v3 — Environment Variables

# Database
DATABASE_URL="postgresql://mbm:mbm@localhost:5432/mbm_lead_engine"

# Redis (for BullMQ queues)
REDIS_URL="redis://localhost:6379"

# JWT Secret for auth
JWT_SECRET="change-me-to-a-long-random-secret"

# Encryption key for sensitive data
ENCRYPTION_KEY="change-me-to-a-32-char-key"

# Server
PORT=4000
NODE_ENV=development

# Default admin credentials (change on first login)
ADMIN_EMAIL=admin@mbm.io
ADMIN_PASSWORD=change-me-admin-password

# Storage (local or S3-compatible)
STORAGE_TYPE=local
STORAGE_PATH=./data/exports
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# Optional: AI provider for lead summaries and market analysis
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
