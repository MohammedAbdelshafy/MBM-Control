# MBM Lead Engine v3 — Environment Variables

# Database
DATABASE_URL="postgresql://mbm:mbm@localhost:5432/mbm_lead_engine"

# Redis (for BullMQ queues)
REDIS_URL="redis://localhost:6379"

# JWT Secret for auth
JWT_SECRET="change-me-to-a-long-random-secret"

# Encryption key for sensitive data
ENCRYPTION_KEY="change-me-to-a-32-char-key"

# Server
PORT=4000
NODE_ENV=development

# Default admin credentials (change on first login)
ADMIN_EMAIL=admin@mbm.io
ADMIN_PASSWORD=change-me-admin-password

# Storage (local or S3-compatible)
STORAGE_TYPE=local
STORAGE_PATH=./data/exports
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# Optional: AI provider for lead summaries and market analysis
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── zillow_inspection — authorized Zillow property-signal layer ────────────
# Master switch. Defaults to FALSE: the module is inert until enabled AND a
# credential below is provided. Only ever talks to an authorized provider;
# never scrapes Zillow HTML, never tracks visitors, never emits contact data.
ZILLOW_ENABLED=false
# Provider name: "zillapi" (default) or "mock" (tests/dry-run only).
ZILLOW_PROVIDER=zillapi
# Authorized Zillapi bearer token (shared with property_intel.off_market_verifier).
ZILLAPI_KEY=
# Cache + tuning (optional overrides)
ZILLOW_CACHE_DIR=
ZILLOW_CACHE_TTL_DAYS=30
ZILLOW_RATE_PER_MINUTE=30
ZILLOW_RETRY_BASE_S=1.0
ZILLOW_MAX_RETRIES=3
ZILLOW_TIMEOUT_S=30

# ── Intelligence Layer (additive, all OFF by default) ───────────────────────
INTELLIGENCE_ENABLED=false
WORLDMONITOR_ENABLED=false
WORLDMONITOR_API_KEY=
WORLDMONITOR_BASE_URL=https://worldmonitor.app
WORLDMONITOR_MCP_URL=
INTELLIGENCE_NICHE_KEYWORDS=
INTELLIGENCE_AUDIENCE_KEYWORDS=
ANDERRO_ENABLED=false
ANDERRO_API_KEY=
TOPVIEW_ENABLED=false
TOPVIEW_API_KEY=
SKYSNAIL_ENABLED=false
SKYSNAIL_API_KEY=
VOXCPM_ENABLED=false
