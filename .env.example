# Root Environment Variables
# Copy this file to .env and insert valid credentials.

# Supabase (shared across app, server, and workflows)
VITE_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# SMTP / Email (used by email queue system)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_FROM_NAME=""

# Clipping Factory API
CLIPPING_EMAIL=""
CLIPPING_PASSWORD=""
CLIPPING_FACTORY_API_URL=""

# Telegram Alerts (for email queue monitor)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Base44 (local development)
BASE44_API_KEY=""

# Twilio (outbound calling / progressive dialer)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_API_KEY=""
TWILIO_API_SECRET=""
