# Root Environment Variables
# Copy this file to .env and insert valid credentials.

# Supabase (shared across app, server, and workflows)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# SMTP / Email (used by email queue system)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_FROM_NAME=""

# Clipping Factory API
CLIPPING_EMAIL=""
CLIPPING_PASSWORD=""
CLIPPING_FACTORY_API_URL=""

# Telegram Alerts (for email queue monitor)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# GTM Notification Center (MBM/LeadEngine/gtm_notification_bus.py)
# The MBM GTM Telegram channel. P0/P1 events (critical failures, deal won,
# revenue received, meetings, HOT buyers, positive replies) deliver on Telegram
# when the channel is enabled. P2 digests (daily brief, new leads, warm
# signals, routine follow-up) are opt-in via the per-kind toggles below.
# NEVER commit a real bot token / chat id — set these in your local .env.
GTM_TELEGRAM_ENABLED="false"
GTM_TELEGRAM_BOT_TOKEN=""
GTM_TELEGRAM_CHAT_ID=""
# P0/P1 deliver on telegram by default when the channel is enabled.
GTM_TELEGRAM_DAILY_BRIEF="false"
GTM_TELEGRAM_MEETINGS="false"
GTM_TELEGRAM_HOT_BUYERS="false"
GTM_TELEGRAM_POSITIVE_REPLIES="false"
GTM_TELEGRAM_FAILURES="false"
# Optional webhook channel (JSON POST). Leave empty to disable.
GTM_WEBHOOK_URL=""

# Base44 (local development)
BASE44_API_KEY=""

# Express API security (server/index.js)
# SECURITY: When API_BEARER_TOKEN is set, sensitive /api routes (dialer PII,
# Twilio call endpoints, orders, payout, telegram-alert) require
# `Authorization: Bearer <token>`. The frontend must send the same token —
# mirror it via the `api_bearer_token` app param until the API client is wired.
# Leave blank only for localhost-only dev (server logs a loud warning).
API_BEARER_TOKEN=""
# Comma-separated list of allowed browser origins (default: Vite dev server).
# Add your deployed frontend origin(s) here. Never use "*".
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Whop monetization (MBM/Whop/whop_monetize.py)
# SECURITY: WHOP_ACCOUNT_ID is per-account. Do NOT commit a real value here.
# Leave blank and set it in your local .env via `whop whoami --show-account-id`.
WHOP_API_URL="https://api.whop.com/api/v1"
WHOP_ACCOUNT_ID=""
WHOP_API_KEY=""

# Legacy Twilio calling (kept for compatibility; MBM Dialer should prefer Phound)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
# API-key auth (server reads TWILIO_API_KEY_SID / TWILIO_API_KEY_SECRET)
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""

# Legacy Twilio API-key pair (used by dialer adapters)
TWILIO_API_KEY=""
TWILIO_API_SECRET=""

# MBM Dialer → Phound provider adapter
# Leave disabled until an official Phound API/integration endpoint is provided for the account.
PHOUND_ENABLED="false"
PHOUND_CALL_ENDPOINT=""
PHOUND_API_TOKEN=""
PHOUND_TIMEOUT_MS="8000"
PHOUND_AUTH_HEADER="Authorization"

# Phound Wave SMS blasting (see MBM/LeadEngine/phound_wave_campaign.py)
# Native-app mode needs only your Phound number. API mode requires an official
# Phound SMS endpoint + token before any auto-dispatch.
PHOUND_PHONE_NUMBER="+16619909068"
PHOUND_SMS_ENDPOINT=""
# Campaign name registered in Phound Wave (TCR) — used in exports/telemetry.
PHOUND_WAVE_CAMPAIGN=""

# Neteller (canonical monetization / checkout) — https://member.neteller.com
# Every checkout/payout surface routes through NETELLER_EMAIL + NETELLER_ACCOUNT_ID.
# server/neteller.js, src/lib/neteller.js, MBM/Scripts/neteller_config.py all read these.
NETELLER_EMAIL="abdelshafyclapps@gmail.com"
NETELLER_ACCOUNT_ID="4599228811"
# Pay base used to build one-click links (defaults to https://member.neteller.com/pay)
NETELLER_PAY_BASE=""

# Google Cloud / Antigravity Enterprise
# Project ID from Google Cloud Console (https://console.cloud.google.com)
GOOGLE_CLOUD_PROJECT=""
# Deployment location: "global" | "us" | "eu"
GOOGLE_CLOUD_LOCATION="global"
# Set to "true" for headless CLI auth via Application Default Credentials
AGY_ADC_AUTH=""
# Path to service account key JSON (optional if using ADC)
GOOGLE_APPLICATION_CREDENTIALS=""
# Custom Vertex AI endpoint (auto-resolved from location if empty)
GOOGLE_CLOUD_ENDPOINT=""
# Enable VPC Service Controls perimeter
GOOGLE_VPC_SC_ENABLED=""
# Gemini / Google API key (for generativelanguage.googleapis.com)
GOOGLE_API_KEY=""
GEMINI_API_KEY=""
GEMINI_FLASH_MODEL="gemini-2.5-flash"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
NVIDIA_API_KEY=""

# Airtable sync (leads:airtable / leads:export:airtable)
AIRTABLE_API_KEY=""
AIRTABLE_BASE_ID=""
AIRTABLE_TABLE="Leads"

# Facebook Ads (Meta Business SDK — MBM/LeadEngine/ads/facebook_ads_lead_engine.py)
# Create a Meta Business App at https://developers.facebook.com
# Required permissions: ads_read, leads_retrieval, pages_read_engagement
FB_ACCESS_TOKEN=""
FB_AD_ACCOUNT_ID=""
FB_APP_ID=""
FB_APP_SECRET=""
FB_PAGE_ID=""

# Google Ads API (MBM/LeadEngine/ads/google_ads_lead_engine.py)
# Get a developer token at https://ads.google.com/aw/apicenter
# Set up OAuth2 client at https://console.cloud.google.com/apis/credentials
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# Ads Budget Controls (hard daily spend caps — enforced in code)
ADS_MAX_DAILY_SPEND_FB="50.00"
ADS_MAX_DAILY_SPEND_GOOGLE="50.00"

# ChatGPT script generator (leads:scripts / leads:scripts:apply)
OPENAI_API_KEY=""
