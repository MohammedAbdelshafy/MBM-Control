    "clip:monitor": "cd clipping-factory/backend && .venv\\Scripts\\python.exe -c \"from app.agents.monetization_agent import MonetizationAgent; from app.core.database import SyncSessionLocal; db=SyncSessionLocal(); print(MonetizationAgent(db=db)._safe_run().data); db.close()\"",
    "clip:quality": "cd clipping-factory/backend && .venv\\Scripts\\python.exe -c \"from app.services.video_processor import VideoProcessor; print('Quality tools: edge-tts OK, whisperx OK')\"",
    "clip:analytics": "cd clipping-factory/backend && .venv\\Scripts\\python.exe -c \"from app.workers.analytics_tasks import sync_post_metrics; r=sync_post_metrics(); print(r)\"",
    "clip:report": "cd clipping-factory/backend && .venv\\Scripts\\python.exe -c \"from app.services.analytics import AnalyticsService; from app.core.database import SyncSessionLocal; db=SyncSessionLocal(); a=AnalyticsService(db=db); print('Platform Comparison:', a.platform_comparison()); print('Top Clips:', a.top_performing_clips(5)); db.close()\"",
    "clip:multi-deliver": "cd clipping-factory/backend && .venv\\Scripts\\python.exe -c \"from app.agents.multi_platform_delivery import MultiPlatformDeliveryAgent; from app.core.database import SyncSessionLocal; import sys; clip_id=sys.argv[1] if len(sys.argv)>1 else None; db=SyncSessionLocal(); a=MultiPlatformDeliveryAgent(db=db); r=a.run(clip_id=clip_id) if clip_id else AgentResult.fail('Provide clip_id'); print(r); db.close()\"",
