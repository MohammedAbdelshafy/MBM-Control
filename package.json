{
  "name": "base44-ai-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "start": "node start.cjs",
    "build": "vite build",
    "send-emails": "node server/emailSender.js",
    "demo:generate": "node server/demoCampaign.js --generate",
    "demo:campaign": "node server/demoCampaign.js --campaign",
    "demo:once": "node server/demoCampaign.js --once",
    "demo:daemon": "node server/demoCampaign.js --daemon",
    "hunt": "node server/clientHunter.js",
    "hunt:send": "node server/clientHunter.js --send",
    "hunt:report": "node server/clientHunter.js --report",
    "hunter:send": "node server/hunterSend.js --send",
    "hunter:dry-run": "node server/hunterSend.js --dry-run",
    "hunter:daemon": "node server/hunterSend.js --daemon",
    "hunter:schedule": "powershell -ExecutionPolicy Bypass -File MBM/Scripts/install_hunter_scheduler.ps1",
    "agent:hourly": "python MBM/LeadEngine/hourly_outreach_agent.py",
    "whatsapp:generate": "python MBM/LeadEngine/whatsapp_sms_blaster.py",
    "cutedosage:pipeline": "python MBM/Scripts/cutedosage_pipeline.py",
    "publish:all": "python MBM/Scripts/master_publisher.py",
    "demo:quality": "python scripts/quality_enhance_and_send.py",
    "demo:build": "node server/demoBuilder.js --batch",
    "demo:page": "node server/demoBuilder.js",
    "clip:build": "cd clipping-factory/backend && .venv\\Scripts\\python.exe build_one_clip.py",
    "clip:seed": "cd clipping-factory/backend && .venv\\Scripts\\python.exe seed_campaigns.py",
    "clip:server": "cd clipping-factory/backend && .venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000",
    "clip:monitor": "cd clipping-factory/backend && .venv\\Scripts\\python.exe -c \"from app.agents.monetization_agent import MonetizationAgent; from app.core.database import SyncSessionLocal; db=SyncSessionLocal(); print(MonetizationAgent(db=db)._safe_run().data); db.close()\"",
    "clip:quality": "cd clipping-factory/backend && .venv\\Scripts\\python.exe -c \"from app.services.video_processor import VideoProcessor; print('Quality tools: edge-tts OK, whisperx OK')\"",
    "clip:analytics": "cd clipping-factory/backend && .venv\\Scripts\\python.exe -c \"from app.workers.analytics_tasks import sync_post_metrics; r=sync_post_metrics(); print(r)\"",
    "clip:report": "cd clipping-factory/backend && .venv\\Scripts\\python.exe -c \"from app.services.analytics import AnalyticsService; from app.core.database import SyncSessionLocal; db=SyncSessionLocal(); a=AnalyticsService(db=db); print('Platform Comparison:', a.platform_comparison()); print('Top Clips:', a.top_performing_clips(5)); db.close()\"",
    "clip:multi-deliver": "cd clipping-factory/backend && .venv\\Scripts\\python.exe -c \"from app.agents.multi_platform_delivery import MultiPlatformDeliveryAgent; from app.core.database import SyncSessionLocal; import sys; clip_id=sys.argv[1] if len(sys.argv)>1 else None; db=SyncSessionLocal(); a=MultiPlatformDeliveryAgent(db=db); r=a.run(clip_id=clip_id) if clip_id else AgentResult.fail('Provide clip_id'); print(r); db.close()\"",
    "lint": "eslint src/ --quiet",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview",
    "whop:monitor": "python MBM/Whop/whop_monetize.py monitor",
    "whop:engage": "python MBM/Whop/whop_lifecycle_engage.py",
    "whop:engage:dry": "python MBM/Whop/whop_lifecycle_engage.py --dry-run",
    "whop:report": "python MBM/Whop/whop_monetize.py report",
    "whop:digest": "python MBM/Whop/whop_monetize.py report",
    "whop:all": "npm run whop:monitor && npm run whop:report && npm run whop:engage:dry",
    "whop:publish": "python MBM/Whop/whop_monetize.py publish",
    "whop:affiliate": "python MBM/Whop/whop_monetize.py affiliate",
    "social:publish": "python -m clipping-factory.MBM-Social.mbm_social.shortform_publisher"
  },
